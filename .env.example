# Frontend (Vite builds with these)
VITE_API_URL=/api
VITE_SOCKET_URL=
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Backend (Vercel serverless)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/cean?retryWrites=true&w=majority
JWT_SECRET=cean_super_secret_change_this_to_random_string
CLIENT_URL=https://cean-network.vercel.app
NODE_ENV=production
PORT=5000